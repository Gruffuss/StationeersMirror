<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../Stationeers.VS.User.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../MirrorRecovery.cs" Link="MirrorRecovery.cs" />
    <Compile Include="../../ControlPolicy.cs" Link="ControlPolicy.cs" />
    <Compile Include="../../AnimatorControlPolicy.cs" Link="AnimatorControlPolicy.cs" />
    <Compile Include="../../MirrorVariant.cs" Link="MirrorVariant.cs" />
    <Compile Include="../../ControlTransformMath.cs" Link="ControlTransformMath.cs" />
    <Compile Include="../../SelectionBoundsMath.cs" Link="SelectionBoundsMath.cs" />
    <Reference Include="Mono.Cecil">
      <HintPath>$(SteamLibraryDirectory)/Stationeers/BepInEx/core/Mono.Cecil.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
